+
+test('post-lookup abstention withholds related evidence without changing initial search instructions', async () => {
+ const u=await user('postlookup');await capture(u,'I prefer vegetarian meals.');
+ const model=scripted([turn('search_personal_memory',{query:'vegetarian'}),final('[INSUFFICIENT_EVIDENCE]')]);
+ const s=await session(u,{model});s.deps.requireEvidence=true;
+ const r=await s.run();
+ assert.equal(model.calls[0].instructions,m('instructions').AGENT_INSTRUCTIONS);
+ assert.equal(model.calls[1].instructions,m('instructions').ANSWER_INSTRUCTIONS);
+ assert.equal(r.status,'completed');assert.equal(r.grounding,'no_evidence');
+ assert.equal(r.answer,m('instructions').ABSTENTION_TEXT);assert.deepEqual(r.sources,[]);
+ assert.equal(r.receipts[0].status,'succeeded');
+});
+
+test('post-lookup abstention cannot hide denied tools or failed receipt persistence', async () => {
+ const u=await user('postlookup-denied');
+ const denied=await session(u,{model:scripted([turn('send_email',{}),final('[INSUFFICIENT_EVIDENCE]')])});
+ const d=await denied.run();assert.equal(d.status,'failed');assert.equal(d.answer,null);
+ await capture(u,'I prefer vegetarian meals.');
+ const s=await session(u,{model:scripted([turn('search_personal_memory',{query:'vegetarian'}),final('[INSUFFICIENT_EVIDENCE]')])});
+ h.db.setFailPattern(/UPDATE agent_execution_receipts/);
+ try{const r=await s.run();assert.equal(r.status,'failed');assert.equal(r.answer,null);assert.deepEqual(r.sources,[]);}
+ finally{h.db.setFailPattern(null);}
+});
