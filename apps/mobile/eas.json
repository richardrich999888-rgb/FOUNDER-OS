{
  "cli": {
    "version": ">= 14.4.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ALPHA_DISTRIBUTION": "development"
      }
    },
    "preview": {
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://replace-with-railway-api",
        "EXPO_PUBLIC_ALPHA_DISTRIBUTION": "testflight",
        "EXPO_PUBLIC_FEATURE_ALPHA_FEEDBACK": "true",
        "EXPO_PUBLIC_FEATURE_RETRIEVAL_EVALUATION": "true",
        "EXPO_PUBLIC_FEATURE_CRASH_REPORTING": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://replace-with-railway-api",
        "EXPO_PUBLIC_ALPHA_DISTRIBUTION": "production",
        "EXPO_PUBLIC_FEATURE_ALPHA_FEEDBACK": "true",
        "EXPO_PUBLIC_FEATURE_RETRIEVAL_EVALUATION": "true",
        "EXPO_PUBLIC_FEATURE_CRASH_REPORTING": "true"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
